DATABASE_PATH=/var/lib/ecc/ecc-crm.sqlite3
BACKUP_DIR=/var/backups/ecc
# Encrypted off-site repository must already be initialized using restic init.
RESTIC_REPOSITORY=s3:https://s3.example/bucket/ecc
RESTIC_PASSWORD_FILE=/etc/ecc/restic-password
# SFTP is also supported with a service-account SSH configuration under /etc.
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY may be supplied privately for S3.
# Keep the encryption key separately for disaster recovery.
RESTIC_CACHE_DIR=/var/backups/ecc/restic-cache
ALERT_WEBHOOK_URL=https://alerts.example/ecc
ALERT_TOKEN_FILE=/etc/ecc/alert-token

# Public, unauthenticated readiness endpoint; no secrets in this URL.
HEALTH_URL=https://crm.example.com/api/ready
