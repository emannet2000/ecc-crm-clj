# Set INTEGRATIONS_ENABLED on the API too. Keep credentials on the worker only.
INTEGRATIONS_ENABLED=zoom,google,stripe,docusign
# Generate once per deployment and keep stable across upgrades and restores.
INTEGRATION_NAMESPACE=REPLACE_WITH_STABLE_RANDOM_INSTANCE_ID
PUBLIC_URL=https://YOUR_APP.example.com
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_USER=
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Start in test mode. Use a Stripe account supporting your operating country.
STRIPE_SECRET_KEY=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_CLIENT_ID=
DOCUSIGN_CLIENT_SECRET=
DOCUSIGN_AUTH_HOST=account-d.docusign.com
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi
# Writable 0600 file on persistent storage. OAuth refresh may rotate this value.
DOCUSIGN_REFRESH_TOKEN_FILE=/var/lib/ecc/secrets/docusign-refresh-token
