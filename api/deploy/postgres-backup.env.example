APP_ENV=production
# Set real values privately in Render. No passwords belong in this file.
DATABASE_URL=postgresql://USER:PASSWORD@DATABASE_HOST/DATABASE_NAME?sslmode=require
# Separate empty database. Its database name must start with ecc_restore_.
RESTORE_TEST_DATABASE_URL=postgresql://TEST_USER:TEST_PASSWORD@TEST_DATABASE_HOST/ecc_restore_drill?sslmode=require
BACKUP_DIR=/var/backups/ecc
RESTIC_REPOSITORY=s3:https://s3.example.invalid/bucket/ecc-crm
# Render secret env var: copied to a temporary mode-0600 file by the entry point.
RESTIC_PASSWORD=SET_A_PRIVATE_RANDOM_ENCRYPTION_PASSWORD
RESTIC_CACHE_DIR=/var/backups/ecc/restic-cache
AWS_ACCESS_KEY_ID=SET_PRIVATELY
AWS_SECRET_ACCESS_KEY=SET_PRIVATELY
HEALTH_URL=https://YOUR_APP.onrender.com/api/ready
ALERT_WEBHOOK_URL=https://YOUR_ALERT_SERVICE.example.invalid/ecc
# Optional Render secret file if the alert receiver requires a bearer token.
# ALERT_TOKEN_FILE=/etc/secrets/ecc-alert-token
