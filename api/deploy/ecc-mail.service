[Unit]
Description=ECC mail worker
After=network-online.target
[Service]
Type=simple
User=ecc
Group=ecc
WorkingDirectory=/opt/ecc/api
EnvironmentFile=/etc/ecc/workers.env
ExecStart=/usr/bin/python3 /opt/ecc/api/scripts/mail_worker.py
Restart=always
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ecc
[Install]
WantedBy=multi-user.target
