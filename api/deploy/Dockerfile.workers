FROM python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258
RUN apt-get update && apt-get install -y --no-install-recommends libpq5 ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY scripts/requirements.txt ./scripts/requirements.txt
RUN pip install --no-cache-dir -r scripts/requirements.txt
COPY scripts/*.py ./scripts/
COPY src/ECC/Release.hs ./src/ECC/Release.hs
COPY web/src/Release.elm ./web/src/Release.elm
COPY migrations ./migrations
RUN useradd --system --uid 10001 worker && install -d -o worker -g worker -m 0700 /var/lib/ecc/secrets
USER worker
CMD ["python3", "scripts/scan_worker.py"]
