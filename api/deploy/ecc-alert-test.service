[Unit]
Description=ECC backup, email and malware scanning alert channel verification
After=network-online.target
[Service]
Type=oneshot
User=ecc
Group=ecc
WorkingDirectory=/opt/ecc/api
EnvironmentFile=/etc/ecc/recovery.env
ExecStart=/usr/bin/python3 /opt/ecc/api/scripts/operations.py alert-test
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/ecc
