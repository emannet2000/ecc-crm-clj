APP_ENV=production
SEED_DEMO=false
CRM_TIMEZONE=Asia/Manila
WEB_DIST=/app/web/dist
# Use the existing database only after confirming it belongs to this ECC CRM.
# Rotate the exposed password in Render and update every dependent service.
DATABASE_URL=postgresql://USER:NEW_PASSWORD@EXISTING_DATABASE_HOST/DATABASE_NAME?sslmode=require
JWT_SECRET=SET_A_FRESH_PRIVATE_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
PUBLIC_URL=https://YOUR_APP.onrender.com
DB_POOL_SIZE=2
# Set true only if staff should see assigned records exclusively.
ASSIGNED_ONLY=false

# Mount a persistent disk here, writable by container UID 10001.
API_LOG_DIR=/var/log/ecc
# HTTPS webhook receiving JSON {event, problems, ...}; configure before production.
# ALERT_WEBHOOK_URL=https://YOUR_ALERT_RECEIVER/ecc
# Optional private bearer-token secret file, mode 0400 or 0600.
# ALERT_TOKEN_FILE=/etc/secrets/ecc-alert-token
