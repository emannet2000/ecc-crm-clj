[Unit]
Description=ECC verified backups, encrypted off-site copy and restore drill
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ecc
Group=ecc
WorkingDirectory=/opt/ecc/api
EnvironmentFile=/etc/ecc/recovery.env
ExecStart=/usr/bin/python3 /opt/ecc/api/scripts/operations.py backup
TimeoutStartSec=2400
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ecc /var/backups/ecc
