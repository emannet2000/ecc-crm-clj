[Unit]
Description=ECC verified online backups and restore drills
After=local-fs.target
[Service]
Type=simple
User=ecc
Group=ecc
WorkingDirectory=/opt/ecc/api
EnvironmentFile=/etc/ecc/recovery.env
ExecStart=/usr/bin/python3 /opt/ecc/api/scripts/recovery.py run --latest 24 --daily 7 --weekly 4 --monthly 12 --interval 3600 --drill-interval 86400
Restart=on-failure
RestartSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ecc /var/backups/ecc
[Install]
WantedBy=multi-user.target
