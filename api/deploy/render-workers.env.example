APP_ENV=production
DATABASE_URL=postgresql://USER:NEW_PASSWORD@EXISTING_DATABASE_HOST/DATABASE_NAME?sslmode=require
CRM_TIMEZONE=Asia/Manila
# Use the private scanner hostname in the same Render region/network.
CLAMD_HOST=YOUR_PRIVATE_CLAMAV_HOST
CLAMD_PORT=3310
# Email is optional; configure the mail worker only if enabling email delivery.
# SMTP_HOST=YOUR_SMTP_HOST
# SMTP_PORT=587
# SMTP_TLS=starttls
# SMTP_FROM=YOUR_SENDER_ADDRESS
# SMTP_USER=SET_PRIVATELY
# SMTP_PASSWORD=SET_PRIVATELY
