APP_ENV=production
SEED_DEMO=false
CRM_TIMEZONE=Asia/Manila
WEB_DIST=/app/web/dist
# Remove DATABASE_URL from the Render service entirely when choosing SQLite.
# Attach a persistent disk at /var/log/ecc, writable by container UID 10001.
# Keeping the database and logs under one mount uses one persistent disk.
DATABASE_PATH=/var/log/ecc/ecc-crm.sqlite3
API_LOG_DIR=/var/log/ecc
JWT_SECRET=SET_A_PRIVATE_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
PUBLIC_URL=https://YOUR_NEW_APP.onrender.com
DB_POOL_SIZE=2
ASSIGNED_ONLY=false
# SQLite migrations must run on the serving instance, where the disk is mounted.
# Docker Command:
# /bin/sh -c 'ecc-crm-api migrate && exec python3 scripts/log_runtime.py -- ecc-crm-api'
# Keep one API instance and coordinate schema upgrades with all writers.
