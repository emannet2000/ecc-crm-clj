# The default runtime is Clojure + XTDB + ClojureScript/Reitit/re-frame.
# Generate BACKUP_TOKEN with: openssl rand -base64 48 | tr '+/' '-_' | tr -d '=\n'
SITE_HOST=crm.example.com
PUBLIC_URL=https://crm.example.com
BACKUP_TOKEN=replace_with_at_least_32_random_url_safe_characters
ASSIGNED_ONLY=false
REQUIRE_ADMIN_MFA=true
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ECC Workspace <workspace@example.com>
ALERT_TO=
BACKUP_INTERVAL_SECONDS=3600
BACKUP_KEEP_LOCAL=24
MAX_BACKUP_AGE_SECONDS=7200
# Optional provider credentials belong in the untracked integrations.env file.
INTEGRATIONS_ENABLED=
INTEGRATION_NAMESPACE=replace_with_a_unique_workspace_identifier
# Optional encrypted off-host backups use compose.offhost.yaml.
# RESTIC_REPOSITORY=s3:https://s3.example.com/bucket/ecc-crm
# RESTIC_PASSWORD_PATH=/secure/ecc-restic-password
# BACKUP_ACCESS_KEY_ID=
# BACKUP_SECRET_ACCESS_KEY=
# BACKUP_REGION=
