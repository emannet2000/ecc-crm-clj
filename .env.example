# Copy to .env. Generate separate random values; do not commit .env.
JWT_SECRET=replace_with_at_least_32_random_bytes
PROXY_TOKEN=replace_with_a_separate_32_byte_random_secret
SITE_HOST=crm.example.com
PUBLIC_URL=https://crm.example.com
ASSIGNED_ONLY=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ECC Workspace <workspace@example.com>

# Enable with docker compose --profile monitoring up -d
ALERT_TO=

# Hourly snapshots; 24 retained locally. Enable compose.offhost.yaml for encrypted replication.
BACKUP_INTERVAL_SECONDS=3600
BACKUP_KEEP_LOCAL=24
MAX_BACKUP_AGE_SECONDS=7200
# RESTIC_REPOSITORY=s3:https://s3.example.com/bucket/ecc-crm
# RESTIC_PASSWORD_PATH=/secure/ecc-restic-password
# BACKUP_ACCESS_KEY_ID=
# BACKUP_SECRET_ACCESS_KEY=
# BACKUP_REGION=

REQUIRE_ADMIN_MFA=true
